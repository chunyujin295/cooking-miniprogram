.page {
  padding: var(--space-block);
  min-height: 100vh;
  box-sizing: border-box;
  /* 只做透明度，避免 transform 影响 fixed 元素定位 */
  animation: page-fade var(--dur-base) ease-out both;
}

@keyframes page-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 卡片入场：translateY 会有位移，只给非 fixed 的内容用 */
.card-in {
  animation: card-up var(--dur-base) var(--ease-out) both;
}

@keyframes card-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 按压反馈：只改 transform / opacity，走合成层 */
.press {
  transform: scale(0.97);
  opacity: 0.88;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.card {
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  background: var(--color-bg);
}

.muted {
  color: var(--color-muted);
  font-size: 24rpx;
}

.placeholder {
  margin-top: 16rpx;
  padding: 40rpx 20rpx;
  border: 1rpx dashed var(--color-line);
  border-radius: var(--radius-card);
  color: var(--color-muted);
  font-size: 26rpx;
  text-align: center;
}

.btn-primary {
  background: var(--color-accent);
  color: #ffffff;
  border-radius: var(--radius-pill);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.tag {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-accent-weak);
  color: var(--color-accent);
  font-size: 22rpx;
}

/* 未登录时的浏览态：先看功能，再自行决定是否登录 */
.guest {
  padding: 40rpx 8rpx 0;
}

.guest-brand {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.guest-slogan {
  margin-top: 12rpx;
  color: var(--color-ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.guest-list {
  margin-top: 36rpx;
}

.guest-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-bg);
}

.guest-item-title {
  font-size: 28rpx;
  font-weight: 600;
}

.guest-item-desc {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.guest-btn {
  margin-top: 36rpx;
}

.guest-tip {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}