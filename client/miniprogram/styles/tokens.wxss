page {
  --color-bg: #ffffff;
  --color-surface: #f7f8f7;
  --color-surface-2: #f2f4f2;
  /* 辅助色块（底部操作栏、分段控件底槽），比页面底色略深一档用于分层 */
  --color-bar: #ebefeb;
  --color-line: #e3e8e4;
  --color-line-strong: #d6ddd7;
  --color-ink: #1d211e;
  --color-ink-2: #46504a;
  --color-muted: #747e78;
  --color-accent: #2e7d5b;
  --color-accent-weak: #eaf4ef;
  --color-amber: #9a6b13;
  --color-amber-weak: #fdf5e4;
  --radius-card: 20rpx;
  --radius-pill: 40rpx;
  --space-block: 24rpx;
  --space-card: 20rpx;
  /* 动效曲线：out 用于入场减速，spring 用于按压回弹 */
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast: 140ms;
  --dur-base: 240ms;
  background: var(--color-bg);
  color: var(--color-ink);
  font-size: 28rpx;
  line-height: 1.6;
}
