.seg {
  display: flex;
  background: var(--color-surface-2);
  border-radius: 40rpx;
  padding: 6rpx;
  margin: 32rpx 0 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--color-muted);
  border-radius: 36rpx;
}

.seg-item.on {
  background: #ffffff;
  color: var(--color-ink);
  font-weight: 600;
}

.label {
  margin: 24rpx 0 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.input {
  border: 1rpx solid var(--color-line);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  background: #ffffff;
}

.submit {
  margin-top: 48rpx;
}

.error {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #a8443c;
}