.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  margin-bottom: 12rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-surface-2);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--color-line);
  color: var(--color-muted);
  font-size: 22rpx;
}

.field-card {
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.input {
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.notify-btn {
  margin-top: 16rpx;
  background: var(--color-surface);
  color: var(--color-accent);
  border: 1rpx solid var(--color-accent);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--color-ink-2);
}

.chip.on {
  border-color: #c0503f;
  background: #fbeeec;
  color: #a8443c;
}

.inline-add {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.input.slim {
  flex: 1;
  height: 64rpx;
  margin-bottom: 0;
}

.mini-btn {
  padding: 10rpx 26rpx;
  border: 1rpx solid var(--color-accent);
  border-radius: var(--radius-pill);
  color: var(--color-accent);
  font-size: 24rpx;
}

.label.second {
  margin-top: 20rpx;
}

.hint-text {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.dietary-btn {
  margin-top: 16rpx;
  background: var(--color-surface);
  color: var(--color-ink-2);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
}

.save {
  margin-top: 24rpx;
}

.error {
  margin-top: 8rpx;
  color: #a33;
  font-size: 24rpx;
}
