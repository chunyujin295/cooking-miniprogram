.step {
  margin-bottom: 20rpx;
}

.step-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-accent-weak);
  color: var(--color-accent);
  font-size: 22rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
}

.desc {
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.hint {
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
}

.textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 24rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-ghost {
  flex: 1;
  padding: 18rpx 0;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-pill);
  background: var(--color-bar);
  color: var(--color-ink-2);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.4;
}

.actions .btn-primary {
  flex: 1;
  padding: 18rpx 0;
  font-size: 26rpx;
}

.error {
  margin-bottom: 12rpx;
  color: #a33;
  font-size: 24rpx;
  line-height: 1.5;
}

.footer {
  margin-top: 8rpx;
  line-height: 1.6;
  font-size: 22rpx;
}

.manual {
  margin-top: 20rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 24rpx;
}
