<view class="page" wx:if="{{recipe}}">
  <swiper wx:if="{{recipe.imagesAbs.length}}" class="gallery" indicator-dots circular>
    <swiper-item wx:for="{{recipe.imagesAbs}}" wx:key="*this">
      <image class="gallery-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="title-row">
    <view class="title">{{recipe.name}}</view>
    <view wx:if="{{recipe.isArchived}}" class="tag archived">已归档</view>
    <view wx:if="{{recipe.source === 'external-ai'}}" class="tag source">外部整理</view>
  </view>

  <view class="tags">
    <text wx:for="{{recipe.tags}}" wx:key="id" class="tag">{{item.name}}</text>
  </view>

  <view class="creator muted">由 {{recipe.creatorName || '家人'}} 添加</view>

  <view class="card meta-grid">
    <view class="meta-item"><text class="muted">份数</text><text>{{recipe.baseServings}} 人</text></view>
    <view class="meta-item"><text class="muted">准备</text><text>{{recipe.prepMinutes}} 分钟</text></view>
    <view class="meta-item"><text class="muted">烹饪</text><text>{{recipe.cookMinutes}} 分钟</text></view>
    <view class="meta-item"><text class="muted">合计</text><text>{{recipe.totalMinutes}} 分钟</text></view>
  </view>

  <view class="card section nutrition">
    <view class="section-title">每份营养（估算）</view>
    <block wx:if="{{recipe.nutrition}}">
      <view class="kcal-row">
        <text class="kcal">{{recipe.nutrition.energyKcal}}</text>
        <text class="kcal-unit">kcal / 份</text>
        <text class="status {{recipe.nutrition.isConfirmed ? 'ok' : ''}}">
          {{recipe.nutrition.isConfirmed ? '已确认' : '待确认'}}
        </text>
      </view>
      <view class="macro-row">
        <view class="macro"><text class="muted">蛋白</text><text>{{recipe.nutrition.proteinG}} g</text></view>
        <view class="macro"><text class="muted">脂肪</text><text>{{recipe.nutrition.fatG}} g</text></view>
        <view class="macro"><text class="muted">碳水</text><text>{{recipe.nutrition.carbohydrateG}} g</text></view>
        <view wx:if="{{recipe.nutrition.fiberG !== null}}" class="macro">
          <text class="muted">纤维</text><text>{{recipe.nutrition.fiberG}} g</text>
        </view>
      </view>
      <view class="muted nutri-note">数值由你使用的 AI 估算，误差通常 ±20%，仅供参考</view>
      <view wx:if="{{!recipe.nutrition.isConfirmed}}" class="nutri-actions">
        <button class="btn-primary small" loading="{{confirming}}" bindtap="onConfirmNutrition">确认数据</button>
      </view>
    </block>
    <block wx:else>
      <view class="muted">
        还没有热量数据。用菜谱页的「整理」按模板让 AI 一并给出热量，导入时会自动带上。
      </view>
    </block>
  </view>

  <view wx:if="{{recipe.description}}" class="card section">
    <view class="section-title">简介</view>
    <view class="desc">{{recipe.description}}</view>
  </view>

  <view class="card section">
    <view class="section-title">食材</view>
    <view wx:for="{{recipe.ingredients}}" wx:key="name" class="row">
      <text>{{item.name}}</text>
      <text class="muted">{{item.quantity}}{{item.unit}}</text>
    </view>
  </view>

  <view class="card section">
    <view class="section-title">做法</view>
    <view wx:for="{{recipe.stepList}}" wx:key="stepNo" class="step">
      <view class="step-no">{{item.stepNo}}</view>
      <view class="step-body">
        <view class="step-text">{{item.content}}</view>
        <image wx:if="{{item.image}}" class="step-img" src="{{item.image}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="onEdit">编辑</button>
    <button class="btn-ghost" loading="{{busy}}" bindtap="onToggleArchive">
      {{recipe.isArchived ? '恢复' : '归档'}}
    </button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>

<view wx:elif="{{loading}}" class="page muted">加载中…</view>
<view wx:else class="page error">{{error || '菜谱不存在'}}</view>
