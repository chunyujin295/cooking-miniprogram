.gallery {
  height: 420rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
}

.archived {
  color: var(--color-amber);
  background: var(--color-amber-weak);
}

.source {
  color: var(--color-muted);
  background: var(--color-surface-2);
}

.tags {
  margin: 12rpx 0 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
  margin-bottom: 16rpx;
}

.meta-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
}

.kcal-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.kcal {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.kcal-unit {
  font-size: 22rpx;
  color: var(--color-muted);
}

.status {
  margin-left: auto;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background: var(--color-amber-weak);
  color: var(--color-amber);
  font-size: 22rpx;
}

.status.ok {
  background: var(--color-accent-weak);
  color: var(--color-accent);
}

.macro-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-bottom: 6rpx;
}

.macro {
  display: flex;
  gap: 6rpx;
  font-size: 25rpx;
}

.nutri-note {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.nutri-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.small {
  flex: 1;
  font-size: 26rpx;
  padding: 14rpx 0;
}

.section {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.desc {
  color: var(--color-ink-2);
  font-size: 26rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 26rpx;
}

.row:last-child {
  border-bottom: none;
}

.step {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-accent-weak);
  color: var(--color-accent);
  font-size: 22rpx;
  flex-shrink: 0;
}

.step-body {
  flex: 1;
}

.step-text {
  font-size: 26rpx;
  color: var(--color-ink-2);
}

.step-img {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 40rpx;
}

.actions .btn-primary {
  flex: 1;
}

.btn-ghost {
  flex: 1;
  background: var(--color-surface);
  color: var(--color-ink-2);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
}

.error {
  color: #a33;
  font-size: 24rpx;
  margin-top: 12rpx;
}
