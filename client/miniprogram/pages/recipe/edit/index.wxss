.import-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-card);
  background: var(--color-accent-weak);
}

.tip-title {
  font-size: 25rpx;
  color: var(--color-accent);
}

.tip-warn {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--color-ink-2);
}

.section {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--color-surface-2);
}

.image-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 26rpx;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--color-line);
  border-radius: 12rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: center;
}

.field {
  margin-bottom: 16rpx;
}

.field-row {
  display: flex;
  gap: 12rpx;
}

.field-row .field {
  flex: 1;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 6rpx;
}

.input {
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 26rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 26rpx;
  box-sizing: border-box;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 8rpx 0 12rpx;
}

.chip {
  min-width: 56rpx;
  padding: 8rpx 20rpx;
  text-align: center;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--color-ink-2);
}

.chip.on {
  border-color: var(--color-accent);
  background: var(--color-accent-weak);
  color: var(--color-accent);
}

.inline-add {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.mini-btn {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--color-accent);
  border-radius: var(--radius-pill);
  color: var(--color-accent);
  font-size: 24rpx;
}

.row-flex {
  display: flex;
  gap: 10rpx;
  align-items: center;
  margin-bottom: 10rpx;
}

.flex-1 {
  flex: 1;
}

.flex-2 {
  flex: 2;
}

.del {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 30rpx;
  flex-shrink: 0;
}

.step-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-accent-weak);
  color: var(--color-accent);
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.error {
  color: #a33;
  font-size: 24rpx;
  margin: 12rpx 0;
}

.save-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 60rpx;
}

.save-row .save {
  flex: 1;
  margin: 0;
}

.btn-danger {
  flex: 0 0 200rpx;
  padding: 20rpx 0;
  border: 1rpx solid #e0b4b0;
  border-radius: var(--radius-pill);
  background: #fff;
  color: #a33;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.4;
}
