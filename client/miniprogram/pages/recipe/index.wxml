<view class="page">
  <block wx:if="{{!loggedIn}}">
    <view class="guest">
      <view class="guest-brand">家庭菜谱</view>
      <view class="guest-slogan">把常做的菜记下来：多图、食材用量、分步做法、时令与每份营养。</view>
      <view class="guest-list">
        <view class="guest-item">
          <view class="guest-item-title">按标签筛选</view>
          <view class="guest-item-desc">下饭、快手、汤羹…登录后可维护自己的标签体系。</view>
        </view>
        <view class="guest-item">
          <view class="guest-item-title">归档不删除</view>
          <view class="guest-item-desc">季节菜先归档，想吃了随时恢复，历史点菜记录也不受影响。</view>
        </view>
      </view>
      <button class="btn-primary guest-btn" bindtap="onGuestLogin">微信登录后查看菜谱</button>
      <view class="guest-tip">登录仅用于同步家庭数据，不读取手机号。</view>
    </view>
  </block>

  <block wx:else>
  <view class="head">
    <input
      class="search"
      placeholder="搜索菜名"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
    />
    <view class="import-btn" bindtap="onImport">导入</view>
    <view class="add-btn" bindtap="onAdd">＋</view>
  </view>

  <view class="scope-row">
    <view class="scope {{showArchived ? '' : 'on'}}" data-archived="0" bindtap="onScopeTap">在用</view>
    <view class="scope {{showArchived ? 'on' : ''}}" data-archived="1" bindtap="onScopeTap">已归档</view>
  </view>

  <scroll-view class="tag-bar" scroll-x wx:if="{{tags.length}}">
    <view
      wx:for="{{tags}}"
      wx:key="id"
      class="tag-chip {{item.selected ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onToggleTag"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="list">
    <view
      wx:for="{{recipes}}"
      wx:key="id"
      class="card recipe-card card-in"
      style="animation-delay: {{index < 6 ? index * 35 : 0}}ms"
      data-id="{{item.id}}"
      bindtap="onOpen"
      hover-class="press"
      hover-stay-time="80"
    >
      <image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill" />
      <view wx:else class="cover cover-empty">无图</view>
      <view class="body">
        <view class="name">{{item.name}}</view>
        <view class="meta">
          <text>{{item.totalMinutes}} 分钟</text>
          <text wx:if="{{item.isArchived}}" class="archived">已归档</text>
        </view>
        <view class="tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id" class="tag">{{tag.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="muted">加载中…</view>
  <view wx:elif="{{!recipes.length}}" class="placeholder">
    {{showArchived ? '还没有归档的菜谱' : '还没有菜谱，点右上角「＋」添加第一道菜'}}
  </view>
  </block>
</view>
