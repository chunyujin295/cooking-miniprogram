.order-page {
  /* 本页在 tabBar 内，安全区由 tabBar 承担，这里不再叠加 */
  padding-bottom: 120rpx;
}

.count-line {
  margin: 4rpx 4rpx 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-muted);
}

.date-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.date-chip {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--color-ink-2);
}

.date-chip.on {
  border-color: var(--color-accent);
  background: var(--color-accent-weak);
  color: var(--color-accent);
}

.date-pick {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bar);
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--color-ink-2);
}

.tab.on {
  background: #ffffff;
  color: var(--color-accent);
  font-weight: 600;
}

.section {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.snack-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 26rpx;
}

.snack-main {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.snack-del {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid var(--color-line);
  color: var(--color-muted);
  font-size: 28rpx;
  flex-shrink: 0;
}

.back-row {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: var(--color-accent);
}

.mini-btn {
  margin-top: 16rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--color-accent);
  border-radius: var(--radius-pill);
  color: var(--color-accent);
  font-size: 24rpx;
  text-align: center;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.summary-link {
  margin-left: auto;
  color: var(--color-accent);
  font-size: 24rpx;
}

.notice {
  margin-bottom: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--color-amber-weak);
  color: var(--color-amber);
  font-size: 24rpx;
}

.search-row {
  margin-bottom: 16rpx;
}

.search {
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  font-size: 26rpx;
}

.tag-bar {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.tag-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--color-ink-2);
}

.tag-chip.on {
  border-color: var(--color-accent);
  background: var(--color-accent-weak);
  color: var(--color-accent);
}

.dish-grid {
  width: 100%;
  height: 620rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.grid-card {
  width: 48.5%;
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

.grid-cover-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--color-surface-2);
}

.grid-cover {
  width: 100%;
  height: 100%;
}

.grid-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 22rpx;
}

.allergen-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #fbeeec;
  color: #a8443c;
  font-size: 20rpx;
}

.grid-overlay {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.92);
}

.ov-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid var(--color-line);
  color: var(--color-ink-2);
  font-size: 26rpx;
}

.ov-btn.plus {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.ov-qty {
  min-width: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-accent);
}

.grid-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-meta {
  font-size: 22rpx;
  color: var(--color-muted);
}

.pick-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.pick-row:last-child {
  border-bottom: none;
}

.pick-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.pick-name {
  flex: 1;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.p-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid var(--color-line);
  color: var(--color-ink-2);
  font-size: 26rpx;
}

.p-btn.plus {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.p-qty {
  min-width: 32rpx;
  text-align: center;
  font-size: 25rpx;
}

.pick-bottom {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.pick-note {
  flex: 1;
  height: 56rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 10rpx;
  background: var(--color-surface);
  font-size: 23rpx;
  box-sizing: border-box;
}

.pick-note-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--color-muted);
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 26rpx;
  box-sizing: border-box;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  background: var(--color-bar);
  border-top: 1rpx solid var(--color-line-strong);
}

.action-bar .btn-primary {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
}

.submit-btn[disabled] {
  background: #c9d6cf;
  color: #ffffff;
}

.btn-ghost {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  font-size: 26rpx;
  color: var(--color-ink-2);
}

.btn-ghost::after {
  border: none;
}

.summary-btn {
  width: 176rpx;
  flex-shrink: 0;
}

.submit-btn {
  min-width: 240rpx;
  flex-shrink: 0;
}

.error {
  margin-bottom: 12rpx;
  color: #a33;
  font-size: 24rpx;
}

.del {
  width: 44rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 30rpx;
  flex-shrink: 0;
}
