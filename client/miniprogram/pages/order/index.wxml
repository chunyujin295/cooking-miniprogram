<view class="page order-page">
  <block wx:if="{{!loggedIn}}">
    <view class="guest">
      <view class="guest-brand">按餐次点菜</view>
      <view class="guest-slogan">早餐、午餐、晚餐、加餐分开点，家人各自提交后自动汇总成制作任务。</view>
      <view class="guest-list">
        <view class="guest-item">
          <view class="guest-item-title">份数与备注</view>
          <view class="guest-item-desc">每道菜可以选份数，也能备注「少油」「不要香菜」。</view>
        </view>
        <view class="guest-item">
          <view class="guest-item-title">过敏提醒</view>
          <view class="guest-item-desc">命中自己的忌口时会在点菜时提醒，不会强行拦截。</view>
        </view>
        <view class="guest-item">
          <view class="guest-item-title">自动汇总</view>
          <view class="guest-item-desc">创建者确认后生成制作任务与采购清单。</view>
        </view>
      </view>
      <button class="btn-primary guest-btn" bindtap="onGuestLogin">微信登录后开始点菜</button>
      <view class="guest-tip">登录仅用于同步家庭数据，不读取手机号。</view>
    </view>
  </block>

  <block wx:else>
  <view class="date-bar">
    <view
      wx:for="{{dateOptions}}"
      wx:key="key"
      class="date-chip {{date === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onDateTap"
    >{{item.label}}</view>
    <picker mode="date" value="{{date}}" bindchange="onDatePick">
      <view class="date-pick">{{date}} ▾</view>
    </picker>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="type"
      class="tab {{mealType === item.type ? 'on' : ''}}"
      data-type="{{item.type}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{mealType === 'snack' && !sessionId}}" class="card section">
    <view class="section-title">今天的加餐</view>
    <view wx:if="{{!snackSessions.length}}" class="muted">今天还没有加餐</view>
    <view
      wx:for="{{snackSessions}}"
      wx:key="id"
      class="snack-row"
    >
      <view class="snack-main" data-id="{{item.id}}" bindtap="onOpenSnack">
        <text>加餐 {{index + 1}}</text>
        <text class="muted">{{item.itemCount}} 份 · {{item.submittedCount}}/{{item.memberCount}} 已提交</text>
      </view>
      <view
        wx:if="{{!item.submittedCount && (item.status === 'not_started' || item.status === 'ordering')}}"
        class="snack-del"
        data-id="{{item.id}}"
        catchtap="onDeleteSnack"
      >×</view>
    </view>
    <view class="mini-btn" bindtap="onAddSnack">＋ 新增加餐</view>
  </view>

  <block wx:if="{{sessionId && detail}}">
    <view wx:if="{{mealType === 'snack'}}" class="back-row" bindtap="onBackToSnacks">‹ 返回加餐列表</view>

    <view class="status-line">
      <text class="tag">{{statusLabel}}</text>
      <text wx:if="{{detail.myOrder}}" class="muted">
        我的点菜：{{dirty ? '有改动未提交' : '已提交'}}
      </text>
    </view>

    <view wx:if="{{!detail.canEdit}}" class="notice">这餐已确认，点菜单只读</view>

    <view class="search-row">
      <input
        class="search"
        placeholder="搜索菜名"
        value="{{keyword}}"
        bindinput="onKeywordInput"
      />
    </view>

    <scroll-view class="tag-bar" scroll-x wx:if="{{tags.length}}">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag-chip {{item.selected ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onToggleTag"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view class="dish-grid" scroll-y enhanced show-scrollbar>
      <view class="grid">
        <view
          wx:for="{{recipes}}"
          wx:key="id"
          class="grid-card card-in"
          style="animation-delay: {{index < 6 ? index * 35 : 0}}ms"
        >
          <view
            class="grid-cover-wrap"
            data-id="{{item.id}}"
            bindtap="onOpenRecipe"
            hover-class="cover-press"
            hover-stay-time="80"
          >
            <image wx:if="{{item.cover}}" class="grid-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
            <view wx:else class="grid-cover grid-cover-empty">无图</view>
            <view wx:if="{{allergenMap[item.id]}}" class="allergen-badge">忌</view>
            <view class="cover-hint">看做法</view>
            <view wx:if="{{detail.canEdit}}" class="grid-overlay">
              <view
                wx:if="{{qtyMap[item.id]}}"
                class="ov-btn"
                data-id="{{item.id}}"
                catchtap="onDishRemove"
                hover-class="ov-press"
                hover-stay-time="60"
              >−</view>
              <text wx:if="{{qtyMap[item.id]}}" class="ov-qty">{{qtyMap[item.id]}}</text>
              <view
                class="ov-btn plus"
                data-id="{{item.id}}"
                catchtap="onDishAdd"
                hover-class="ov-press"
                hover-stay-time="60"
              >＋</view>
            </view>
          </view>
          <view class="grid-name">{{item.name}}</view>
          <view class="grid-meta">{{item.totalMinutes}} 分钟</view>
        </view>
      </view>
      <view wx:if="{{!recipes.length}}" class="placeholder">没有符合条件的菜谱</view>
    </scroll-view>

    <view wx:if="{{picked.length}}" class="card section">
      <view class="section-title">已选 {{picked.length}} 道</view>
      <view wx:for="{{picked}}" wx:key="recipeId" class="pick-row">
        <view class="pick-top">
          <text class="pick-name">{{item.name}}</text>
          <view wx:if="{{detail.canEdit}}" class="pick-stepper">
            <view class="p-btn" data-index="{{index}}" catchtap="onPickMinus">−</view>
            <text class="p-qty">{{item.quantity}}</text>
            <view class="p-btn plus" data-index="{{index}}" catchtap="onPickPlus">＋</view>
          </view>
          <text wx:else class="p-qty">×{{item.quantity}}</text>
        </view>
        <view class="pick-bottom">
          <input
            wx:if="{{detail.canEdit}}"
            class="pick-note"
            placeholder="这道菜的口味/做法备注"
            value="{{item.note}}"
            data-index="{{index}}"
            bindinput="onPickNote"
          />
          <text wx:else class="pick-note-text">{{item.note || '无备注'}}</text>
          <view wx:if="{{detail.canEdit}}" class="del" data-index="{{index}}" catchtap="onPickRemove">×</view>
        </view>
      </view>
    </view>

    <view class="card section">
      <view class="section-title">整餐备注</view>
      <textarea
        class="textarea"
        value="{{note}}"
        bindinput="onNoteInput"
        placeholder="例如 少油、不要香菜"
        maxlength="200"
        disabled="{{!detail.canEdit}}"
      />
    </view>

    <view class="count-line">{{picked.length}} 道 / {{totalQty}} 份</view>

    <view class="action-bar">
      <button
        wx:if="{{detail.canEdit}}"
        class="btn-primary submit-btn"
        loading="{{saving}}"
        disabled="{{!dirty || saving}}"
        bindtap="onSubmit"
      >{{dirty || !detail.myOrder ? '提交' : '已提交'}}</button>
      <button class="btn-ghost summary-btn" bindtap="onOpenSummary">汇总</button>
    </view>
  </block>

  <view wx:if="{{loading}}" class="muted">加载中…</view>
  </block>
</view>
