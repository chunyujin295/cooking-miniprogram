# 容器内运行：数据库与对象存储用服务名
PORT=3000
DATABASE_URL=postgresql://cooking:cooking@postgres:5432/cooking
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=cooking
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
NUTRITION_PROVIDER=stub
NUTRITION_API_KEY=
# 大模型（OpenAI 兼容协议）；不填 LLM_API_KEY 时 AI 菜谱导入自动降级为手动录入
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL_TEXT=glm-4v-flash
LLM_MODEL_VISION=glm-4v-flash